            },
            {
              "id": "seg-article-order-end",
              "text": "."
            }
          ],
          "translationZh": "她问好，然后要了一根法棍。"
        },
        {
          "id": "paragraph-leaving",
          "segments": [
            {
              "id": "seg-article-leaving",
              "text": "Elle demande le prix, puis dit au revoir."
