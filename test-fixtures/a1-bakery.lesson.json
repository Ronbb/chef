{
  "schemaVersion": "1.0",
  "id": "a1-bakery-buy-breakfast",
  "revision": 1,
  "levelId": "a1",
  "unitId": "a1-breakfast-bakery",
  "title": {
    "fr": "Un matin à la boulangerie",
    "zh": "在面包店买早餐"
  },
  "summaryZh": "用简单而礼貌的表达买一根法棍，并询问价格。",
  "estimatedMinutes": 12,
  "objectivesZh": [
    "进入店内时打招呼",
    "礼貌地请求一种商品",
    "询问价格并道别"
  ],
  "knowledge": {
    "vocabulary": [
      {
        "id": "word-bonjour",
        "lemma": "bonjour",
        "partOfSpeech": "interjection",
        "meaningZh": "你好；您好",
        "noteZh": "白天问候。进入店内时可先用它向店员打招呼。"
      },
      {
        "id": "expr-je-voudrais",
        "lemma": "je voudrais",
        "partOfSpeech": "phrase",
        "meaningZh": "我想要……",
        "noteZh": "礼貌地提出请求。本课先作为常用语块学习。"
      },
      {
        "id": "word-baguette",
        "lemma": "baguette",
        "partOfSpeech": "noun",
        "gender": "feminine",
        "meaningZh": "法棍面包",
        "noteZh": "在面包店场景中指法棍；一根法棍说 une baguette。"
      },
      {
        "id": "expr-sil-vous-plait",
        "lemma": "s’il vous plaît",
        "partOfSpeech": "phrase",
        "meaningZh": "请",
        "noteZh": "这里使用 vous，适用于不熟悉的人和服务场景。"
      },
      {
        "id": "expr-cest-combien",
        "lemma": "c’est combien",
        "partOfSpeech": "phrase",
        "meaningZh": "多少钱？",
        "noteZh": "询价的常用口语。本例的价格只是教学情景设定。"
      },
      {
        "id": "expr-au-revoir",
        "lemma": "au revoir",
        "partOfSpeech": "phrase",
        "meaningZh": "再见",
        "noteZh": "结束交谈、离开时使用。"
      }
    ],
    "grammar": [
      {
        "id": "grammar-indefinite-un-une",
        "titleZh": "un / une：一个或一种",
        "bodyZh": "法语名词有语法性别，冠词与它配合。baguette 是阴性名词，所以这里说 une baguette。不要根据物品的自然属性猜语法性别。",
        "examples": [
          {
            "fr": "une baguette",
            "zh": "一根法棍"
          },
          {
            "fr": "un café",
            "zh": "一杯咖啡"
          }
        ]
      },
      {
        "id": "grammar-polite-voudrais-chunk",
        "titleZh": "Je voudrais…：礼貌请求",
        "bodyZh": "voudrais 是 vouloir 的条件式形式。A1 这里先掌握 Je voudrais + 想要的东西，用来礼貌提出请求；后续再系统学习条件式。",
        "examples": [
          {
            "fr": "Je voudrais une baguette, s’il vous plaît.",
            "zh": "我想要一根法棍，谢谢。"
          }
        ]
      }
    ]
  },
