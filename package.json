{
  "name": "chef",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "test:ops": "node --test scripts/tests/*.test.mjs",
    "health:check": "node scripts/health-check.mjs",
    "build": "pnpm --filter @chef/web-fixture build",
    "typecheck": "pnpm --filter @chef/web-fixture typecheck",
    "test:web": "node scripts/web-tests.mjs unit",
    "test:ssr": "node scripts/web-tests.mjs ssr",
    "test:browser": "node scripts/web-tests.mjs browser",
    "test:browser:ssr": "node scripts/web-tests.mjs browser-ssr"
  },
  "devDependencies": {
    "agent-browser": "0.27.0",
    "prettier": "3.9.9"
  }
}
