{
  "include": [
    "../../packages/web/app/**/*",
    "packages/web/app/**/*",
    "../../packages/web/browser-tests/**/*",
    "product.ts",
    ".react-router/types/**/*",
    "vite.config.ts",
    "react-router.config.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "types": ["node", "vite/client"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDirs": [
      ".",
      "./.react-router/types",
      "../../packages/web",
      "./packages/web"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  }
}
